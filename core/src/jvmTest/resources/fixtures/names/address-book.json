{
  "kind": "address-book",
  "name": "address-book",
  "description": "Номер → имя из адресной книги. Номера приводятся как в phone-normalize. Номер в нескольких записях — первое непустое имя по порядку книги; записи без имени имени не дают; не-номера пропускаются.",
  "cases": [
    {
      "name": "same-number-many-forms",
      "entries": [
        {
          "name": "Мама",
          "phones": [
            "8 913 123-45-67",
            "+7 (913) 123 45 67"
          ]
        }
      ],
      "expect": {
        "+79131234567": "Мама"
      }
    },
    {
      "name": "duplicate-first-wins",
      "entries": [
        {
          "name": "Иван работа",
          "phones": [
            "+79131234567"
          ]
        },
        {
          "name": "Ваня",
          "phones": [
            "89131234567"
          ]
        }
      ],
      "expect": {
        "+79131234567": "Иван работа"
      }
    },
    {
      "name": "duplicate-first-non-empty",
      "entries": [
        {
          "name": "  ",
          "phones": [
            "+79131234567"
          ]
        },
        {
          "name": "Ваня",
          "phones": [
            "9131234567"
          ]
        }
      ],
      "expect": {
        "+79131234567": "Ваня"
      }
    },
    {
      "name": "name-trimmed",
      "entries": [
        {
          "name": "  Пётр  ",
          "phones": [
            "+44 20 7946 0958"
          ]
        }
      ],
      "expect": {
        "+442079460958": "Пётр"
      }
    },
    {
      "name": "service-skipped",
      "entries": [
        {
          "name": "Баланс",
          "phones": [
            "900"
          ]
        },
        {
          "name": "Офис",
          "phones": [
            "0044 20 7946 0958",
            "112"
          ]
        }
      ],
      "expect": {
        "+442079460958": "Офис"
      }
    },
    {
      "name": "several-numbers",
      "entries": [
        {
          "name": "Аня",
          "phones": [
            "+79130000001",
            "+79130000002"
          ]
        }
      ],
      "expect": {
        "+79130000001": "Аня",
        "+79130000002": "Аня"
      }
    }
  ]
}
