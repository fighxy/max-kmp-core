{
  "kind": "display-name",
  "name": "display-name",
  "description": "Имя пользователя: адресная книга (если включена и номер совпал) > своё имя контакта (CUSTOM, переименован) > имя, которое пользователь дал себе (ONEME) > первая запись names > номер («+» и цифры) > «Участник». Имя записи — name, иначе «firstName lastName» без пустых частей.",
  "cases": [
    {
      "name": "book-wins",
      "addressBookEnabled": true,
      "addressBook": [
        {
          "name": "Мама",
          "phones": [
            "8 913 123-45-67"
          ]
        }
      ],
      "user": {
        "phone": "79131234567",
        "names": [
          {
            "type": "ONEME",
            "firstName": "Анна",
            "lastName": "Петрова"
          },
          {
            "type": "CUSTOM",
            "firstName": "Аня",
            "lastName": "соседка"
          }
        ]
      },
      "expect": "Мама"
    },
    {
      "name": "book-disabled",
      "addressBookEnabled": false,
      "addressBook": [
        {
          "name": "Мама",
          "phones": [
            "8 913 123-45-67"
          ]
        }
      ],
      "user": {
        "phone": "79131234567",
        "names": [
          {
            "type": "ONEME",
            "firstName": "Анна",
            "lastName": "Петрова"
          },
          {
            "type": "CUSTOM",
            "firstName": "Аня",
            "lastName": "соседка"
          }
        ]
      },
      "expect": "Аня соседка"
    },
    {
      "name": "book-no-match",
