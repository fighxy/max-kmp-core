            "type": "ONEME",
            "firstName": "Анна",
            "lastName": "Петрова"
          },
          {
            "type": "CUSTOM",
            "firstName": "Аня",
            "lastName": "соседка"
          }
        ]
      },
      "expect": "Аня соседка"
    },
