{
  "kind": "phone",
  "name": "phone-normalize",
  "description": "Приведение номера к виду для сравнения: «+» и цифры с кодом страны; null — не номер, не сопоставляется.",
  "cases": [
    {
      "name": "ru-8-spaces-dashes",
      "rule": "8 и 11 цифр без «+» → 7",
      "raw": "8 913 123-45-67",
      "expect": "+79131234567"
    },
    {
      "name": "ru-plus-parens",
      "rule": "разделители убираются",
      "raw": "+7 (913) 123 45 67",
      "expect": "+79131234567"
    },
    {
      "name": "ru-7-no-plus",
      "rule": "11 цифр с 7 без «+» остаются",
      "raw": "79131234567",
      "expect": "+79131234567"
    },
    {
      "name": "ru-8-plain",
      "rule": "8 и 11 цифр без «+» → 7",
      "raw": "89131234567",
      "expect": "+79131234567"
    },
    {
      "name": "ru-10-digits",
      "rule": "10 цифр без «+» → спереди 7",
      "raw": "9131234567",
      "expect": "+79131234567"
    },
    {
      "name": "ru-10-digits-formatted",
      "rule": "10 цифр без «+» → спереди 7",
      "raw": "(913) 123-45-67",
      "expect": "+79131234567"
    },
    {
      "name": "dots",
      "rule": "точки убираются",
      "raw": "8.913.123.45.67",
      "expect": "+79131234567"
    },
    {
      "name": "nbsp-and-dash-variants",
      "rule": "неразрывный пробел и разные тире убираются",
      "raw": "+7 913 123‑45–67",
      "expect": "+79131234567"
    },
    {
      "name": "slash",
      "rule": "косая черта убирается",
      "raw": "8/913/123/45/67",
      "expect": "+79131234567"
    },
    {
      "name": "non-breaking-hyphen-and-en-dash",
      "rule": "неразрывный дефис (U+2011) и короткое тире (U+2013) убираются",
      "raw": "8‑913‑123–45–67",
      "expect": "+79131234567"
    },
    {
      "name": "foreign-plus",
      "rule": "чужой код с «+» как есть",
      "raw": "+44 20 7946 0958",
      "expect": "+442079460958"
    },
    {
      "name": "foreign-00",
      "rule": "ведущие 00 — это «+»",
      "raw": "0044 20 7946 0958",
      "expect": "+442079460958"
    },
    {
      "name": "plus-8-is-foreign",
      "rule": "«+8…» не российская восьмёрка",
      "raw": "+8 800 123 45 67",
      "expect": "+88001234567"
    },
    {
      "name": "kz-plus-7",
      "rule": "+7 с любым кодом — как есть",
      "raw": "+7 701 123 4567",
      "expect": "+77011234567"
    },
    {
      "name": "eight-10-digits",
      "rule": "10 цифр без «+» → спереди 7, даже с 8 в начале",
      "raw": "8991234567",
      "expect": "+78991234567"
    },
    {
      "name": "eight-12-digits",
      "rule": "8 в начале, но не 11 цифр — как есть",
      "raw": "899912345678",
      "expect": "+899912345678"
    },
    {
      "name": "local-7-digits",
      "rule": "7 цифр — минимум, «+» спереди",
      "raw": "123-45-67",
      "expect": "+1234567"
    },
    {
      "name": "short-service",
      "rule": "меньше 7 цифр — не номер",
      "raw": "900",
      "expect": null
    },
    {
      "name": "short-6",
      "rule": "меньше 7 цифр — не номер",
      "raw": "112233",
      "expect": null
    },
    {
      "name": "too-long",
      "rule": "больше 15 цифр — не номер",
      "raw": "+1234567890123456",
      "expect": null
    },
    {
      "name": "max-15",
      "rule": "15 цифр — ещё номер",
      "raw": "+123456789012345",
      "expect": "+123456789012345"
    },
    {
      "name": "letters",
      "rule": "посторонние знаки — не номер",
      "raw": "8 913 ABC-45-67",
      "expect": null
    },
    {
      "name": "plus-inside",
      "rule": "«+» не в начале — не номер",
      "raw": "7+9131234567",
      "expect": null
    },
    {
      "name": "empty",
      "rule": "пусто — не номер",
      "raw": "",
      "expect": null
    },
    {
      "name": "blank",
      "rule": "пусто — не номер",
      "raw": "  ",
      "expect": null
    },
    {
      "name": "null",
      "rule": "нет номера",
      "raw": null,
      "expect": null
    }
  ]
}
