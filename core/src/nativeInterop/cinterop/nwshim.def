# Network.framework calls whose callbacks Kotlin/Native must not bridge as they are.
language = Objective-C
package = com.max.core.transport.nw
---
#import <Network/Network.h>

/*
 * nw_connection_receive without the content context. The context Network.framework passes
 * back can be one of Apple's block-backed sentinels (default stream, final message). Kotlin/Native
 * converts every argument of a block to a Kotlin object before the lambda runs, even an unused
 * one, and aborts on those: "Converting Obj-C blocks with non-reference-typed return value to
 * kotlin.Any is not supported". The context stays on the C side.
 */
typedef void (^max_nw_receive_completion_t)(dispatch_data_t _Nullable content, bool is_complete, nw_error_t _Nullable error);

static inline void max_nw_connection_receive(
    nw_connection_t _Nonnull connection,
    uint32_t minimum,
    uint32_t maximum,
    max_nw_receive_completion_t _Nonnull completion
) {
    nw_connection_receive(connection, minimum, maximum, ^(dispatch_data_t content, nw_content_context_t context, bool is_complete, nw_error_t error) {
        (void)context;
        completion(content, is_complete, error);
    });
}
